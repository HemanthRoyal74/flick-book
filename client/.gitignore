.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.*
*.local

# ─── SYSTEM LOGS ───
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ─── EDITOR DIRECTORIES AND FILES ───
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
